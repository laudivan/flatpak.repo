#!/bin/bash
set -euo pipefail

# Flatpak extra-data installer script
# Extracts dynamic payload downloaded from https://antigravity.google (x86_64 or aarch64)

mkdir -p /app/extra

if [ -f Antigravity.tar.gz ]; then
  ARCHIVE="Antigravity.tar.gz"
fi

if [ -n "${ARCHIVE:-}" ] && [ -f "${ARCHIVE}" ]; then
  tar -xzf "${ARCHIVE}" -C /app/extra --strip-components=1 || tar -xzf "${ARCHIVE}" -C /app/extra
  rm -f "${ARCHIVE}"
else
  echo "Error: No matching Antigravity archive found to unpack." >&2
  exit 1
fi
