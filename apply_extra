#!/bin/bash
set -euo pipefail

# Flatpak extra-data installer script
# Extracts dynamic payload downloaded from https://antigravity.google (x86_64 or aarch64)

mkdir -p /app/extra

if [ -f antigravity-linux-x64.tar.gz ]; then
  ARCHIVE="antigravity-linux-x64.tar.gz"
elif [ -f antigravity-linux-arm64.tar.gz ]; then
  ARCHIVE="antigravity-linux-arm64.tar.gz"
else
  # Fallback to any matching archive in the working directory
  ARCHIVE=$(find . -maxdepth 1 -name "antigravity-linux-*.tar.gz" | head -n 1)
fi

if [ -n "${ARCHIVE:-}" ] && [ -f "${ARCHIVE}" ]; then
  tar -xzf "${ARCHIVE}" -C /app/extra --strip-components=1 || tar -xzf "${ARCHIVE}" -C /app/extra
  rm -f "${ARCHIVE}"
else
  echo "Error: No matching Antigravity archive found to unpack." >&2
  exit 1
fi
